<?xml version="1.0" encoding="utf-8"?>
<!--
  局域网自动更新需要 HTTP 明文访问 192.168.2.4:8765。
  Android 9+ 默认禁止明文流量，因此显式放行本机局域网 IP，
  公网保持默认 HTTPS Only 行为，安全性不受影响。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- 局域网推送服务器 -->
        <domain includeSubdomains="false">192.168.2.4</domain>
        <!-- 兼容常见内网网段（路由器/USB 共享网络/热点变化时回退可用） -->
        <domain includeSubdomains="false">192.168.1.1</domain>
        <domain includeSubdomains="false">192.168.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
